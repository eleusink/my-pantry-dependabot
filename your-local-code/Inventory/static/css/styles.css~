:root{
  --muted: #6b7280;
  --border: rgba(0,0,0,0.15);
  --max: 1100px;
}

*{ box-sizing: border-box; }

body{
  margin: 0;
  font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  background: white;
  color: #222;
}

.container{
  width: min(var(--max), calc(100% - 2rem));
  margin-inline: auto;
}

h1{ margin: 0 0 1rem; }
h2{ margin: 0; }

/* ================= HEADER ================= */

.site-header{
  position: sticky;
  top: 0;
  z-index: 100;
  background: #ff7a00;
  padding: 1.8rem 0;
}

.header-inner{
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand{
  display: flex;
  align-items: center;
}

.brand-icon{
  width: 110px;
  height: auto;
}

.nav{
  display: flex;
  gap: 1rem;
}

.nav-link{
  color: white;
  font-weight: 600;
  text-decoration: none;
  padding: 6px 14px;
  border-radius: 20px;
}

.nav-link:hover{
  background: rgba(255,255,255,0.2);
}

.nav-link:active{
  background: white;
  color: #ff7a00;
}

/* ================= DASHBOARD LAYOUT ================= */

.dashboard{
  padding: 2rem 0 3rem;
}

.panel-grid{
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

.panel{
  background: #efefef;
  border: 2px solid #222;
  border-radius: 18px;
  min-height: 300px;
  position: relative;
  padding: 1rem;
  transition: all 0.3s ease;
}

.panel-header{
	display: flex;
	justify-content: space-between;
	align-items: center;
}

.panel.expanded{
	position: fixed;
	top: 100px;
	left: 5%;
	width: 90%;
	height: 75vh;
	z-index: 999;
	background: white;
	overflow-y: auto;
	box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
}

.panel-wide{
  margin-top: 1.5rem;
}

.panel-wide .panel{
  min-height: 180px;
}

.toggle-btn{
	background:#d9822b;
	color: white;
	border: none;
	padding: 6px 12px;
	border-radius: 8px;
	cursor: pointer;
}

/* ================= ABOUT PAGE ================= */

.about-section{
  padding: 2rem;
  cursor: default;
  caret-color: transparent;
}

.about-section p{
  max-width: 750px;
  color: #444;
}

.about-section ul{
  margin-top: .5rem;
  margin-bottom: .5rem;
  padding-left: 1.5rem;
  color: var(--muted);
}

/* ================= RESPONSIVE ================= */

@media (max-width: 900px){
  .panel-grid{
    grid-template-columns: 1fr;
  }
}
